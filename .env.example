# ==============================================================================
# TAPRD - VARIABLES DE ENTORNO (PLANTILLA SEGURA)
# ==============================================================================
# NUNCA incluyas contraseñas, secretos privados ni claves de Service Account
# en este archivo ni en el control de versiones.

# ------------------------------------------------------------------------------
# 1. VARIABLES PÚBLICAS DE FRONTEND (Prefijo VITE_ obligatorio)
# ------------------------------------------------------------------------------
# Nota: La configuración de cliente Firebase se carga automáticamente desde
# firebase-applet-config.json. Estas variables sirven como override si es necesario.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_APP_CHECK_SITE_KEY=""

# ------------------------------------------------------------------------------
# 2. VARIABLES PRIVADAS DE BACKEND (EXCLUSIVAS DE SERVIDOR / CLOUD FUNCTIONS)
# ------------------------------------------------------------------------------
# NUNCA expongas estas variables con prefijo VITE_ ni en el código del navegador.

# Credenciales de Firebase Admin SDK (JSON stringificado de cuenta de servicio)
# Ejemplo: FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'
FIREBASE_SERVICE_ACCOUNT_KEY=""

# URL base pública del servicio en la nube
APP_URL=""

# Clave de API de Gemini / IA para backend (si aplica)
GEMINI_API_KEY=""

# Proveedores de servicios futuros (Pagos, correos transaccionales, SMS)
# PRIVATE_PAYMENT_GATEWAY_SECRET=""
# PRIVATE_TRANSACTIONAL_EMAIL_KEY=""
# PRIVATE_WHATSAPP_API_TOKEN=""

