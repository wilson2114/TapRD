rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        // Claims en token
        ('role' in request.auth.token && (
          request.auth.token.role == 'ADMIN' || 
          request.auth.token.role == 'admin' || 
          request.auth.token.role == 'superadmin'
        )) ||
        // Correo del administrador único / propietario de TapRD
        ('email' in request.auth.token && (
          request.auth.token.email.lower() == 'wilsonabelinobrito@gmail.com' ||
          request.auth.token.email.lower().matches('.*@taprd[.]com$')
        )) ||
        // Rol en documento Firestore users/{uid}
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'admin', 'superadmin'])
      );
    }

    function isClient() {
      return isAuthenticated() && (
        ('role' in request.auth.token && (
          request.auth.token.role == 'CLIENT' || 
          request.auth.token.role == 'client'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['CLIENT', 'client'])
      );
    }

    function isClientOwner(clientId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId == clientId) ||
        ('clientId' in request.auth.token && request.auth.token.clientId == clientId)
      );
    }

    // =========================================================================
    // COLECCIÓN: users/{userId}
    // =========================================================================
    match /users/{userId} {
      // ADMIN puede leer cualquier usuario; CLIENT solo puede leer su propio usuario
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);

      // Creación: ADMIN o durante activación de cuenta vinculada
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        (request.resource.data.role == 'CLIENT' || request.resource.data.role == 'client')
      );

      // Actualización: ADMIN todo; CLIENT solo su perfil (prohibido cambiar de rol o clientId)
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        request.resource.data.role == resource.data.role && 
        request.resource.data.clientId == resource.data.clientId
      );

      // Eliminación: solo ADMIN
      allow delete: if isAdmin();
    }

    // =========================================================================
    // COLECCIÓN: clients/{clientId}
    // =========================================================================
    match /clients/{clientId} {
      // Lectura pública de perfiles comerciales (NFC y catálogo público /p/:slug)
      allow read: if true;

      // Creación: solo ADMIN
      allow create: if isAdmin();

      // Actualización: ADMIN puede actualizar cualquier campo; CLIENT solo su propio negocio
      // Permite también la actualización durante el flujo de activación del cliente autenticado
      allow update: if isAdmin() || (
        // Flujo de activación legítima por el propio usuario recién autenticado
        (
          isAuthenticated() &&
          request.auth.uid == request.resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'userId', 'clientEmail', 'active', 'status', 'accessStatus', 'updatedAt', 'activationToken',
            'termsAccepted', 'privacyAccepted', 'termsAcceptedAt', 'privacyAcceptedAt', 'termsVersion', 'privacyVersion'
          ]) &&
          request.resource.data.accessStatus == 'active'
        ) ||
        // Flujo normal de cliente propietario (excluyendo estados protegidos y contratos)
        (
          isClientOwner(clientId) && 
          (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'plan', 
            'subscriptionStatus', 
            'subscriptionStartedAt', 
            'subscriptionExpiresAt', 
            'gracePeriodUntil',
            'billingCycle', 
            'paymentProvider', 
            'paymentCustomerId', 
            'paymentSubscriptionId',
            'paymentStatus',
            'amount',
            'currency',
            'lastPaymentAt',
            'nextPaymentAt',
            'contractStatus',
            'contractVersion',
            'contractSignedAt',
            'contractExpiresAt',
            'contractDocumentUrl'
          ]))
        )
      );

      // Eliminación: solo ADMIN
      allow delete: if isAdmin();
    }

    // =========================================================================
    // COLECCIÓN: privacyRequests/{requestId} (PARTE 10 - Derechos ARCO)
    // =========================================================================
    match /privacyRequests/{requestId} {
      // El cliente solo puede leer sus propias solicitudes; ADMIN lee todas
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // El cliente solo puede crear una solicitud vinculada a su propio UID; ADMIN también puede
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);

      // Solo ADMIN puede actualizar (cambiar estado / agregar notas) o eliminar
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // COLECCIÓN: reports/{reportId} (PARTE 10 - Reportes y Moderación)
    // =========================================================================
    match /reports/{reportId} {
      // Cualquier visitante puede enviar un reporte de infracción en un perfil público
      allow create: if true;

      // Solo ADMIN puede consultar los reportes (protegiendo datos del denunciante), moderar o eliminarlos
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // COLECCIÓN: plans/{planId}
    // =========================================================================
    match /plans/{planId} {
      // Lectura pública para visualización en /planes y selección de catálogo
      allow read: if true;

      // Gestión de planes reservada exclusivamente a administradores
      allow write: if isAdmin();
    }

    // =========================================================================
    // COLECCIÓN: subscriptionAuditLogs/{logId}
    // =========================================================================
    match /subscriptionAuditLogs/{logId} {
      // Solo administradores pueden consultar el registro de auditoría
      allow read: if isAdmin();

      // Solo administradores pueden registrar cambios de suscripción
      allow create: if isAdmin();

      // Registro inmutable
      allow update, delete: if false;
    }

    // =========================================================================
    // COLECCIÓN: activations/{tokenId}
    // =========================================================================
    match /activations/{tokenId} {
      // Lectura pública de tokens para verificación en /activar
      allow read: if true;

      // Creación de tokens: permitida para administradores y para registro de activación
      allow create: if true;

      // Actualización: marcar como usado durante la activación autorizada
      allow update: if isAdmin() || (resource.data.used == false && request.resource.data.used == true);

      // Eliminación: solo ADMIN
      allow delete: if isAdmin();
    }

    // =========================================================================
    // COLECCIÓN: auditLogs/{logId}
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================================================
    // COLECCIÓN: system_settings/{settingId}
    // =========================================================================
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
